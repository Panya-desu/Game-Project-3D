  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 583ae739c4c4e2b478ac9f0aaca9e2db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ConfrontationDirector
  dialogueManager: {fileID: 1566162361}
  player: {fileID: 725222318}
  playerCamera: {fileID: 330585546}
  doppelganger: {fileID: 900853234}
  doppelgangerLight: {fileID: 1027538402}
  worldLight: {fileID: 410087040}
  introLines:
  - characterName: You
    text: Where... am I? The white place again?
  - characterName: Navigator
    text: Not quite. This is deeper inside your mind.
  - characterName: Navigator
    text: Be careful. Not every part of you wants to remember.
  confrontationLines:
  - characterName: ???
    text: Stop right there.
  - characterName: You
    text: Who are you...? Why do you have my face?
  - characterName: ???
    text: I'm the part of you that chose to forget.
  - characterName: ???
    text: The clock that stopped. The name on the TV. You're getting too close.
  - characterName: You
    text: I need to know what happened. Who is Evie?
  - characterName: ???
    text: If you remember, it will hurt. Turn back while you still can.
  - characterName: You
    text: I won't run away from my own past.
  - characterName: ???
    text: Then I'll force you out of here.
  startDelay: 2
  rushSeconds: 1.6
  nextScene: DemoEnd
