--- !u!114 &327577758
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 327577757}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af07549d58c92184b8991f567fb1ad6a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TaskManager
  taskText: {fileID: 2063936625}
  quests:
  - questName: Delicious food
    tasks:
    - taskName: Hamburger
      description: Find something to eat
      targetObject: {fileID: 567272858}
      hideAfterInteract: 1
      isCompleted: 0
    afterDialogue:
    - characterName: Yuu
      text: I'll have a hamburger then. Let's give it a try. Even though it's just
        a memory, I'm curious to see what it'll be like.
    - characterName: Navigator
      text: You just felt like trying it, right? You're not actually hungry, are
        you?
    - characterName: Yuu
      text: Sure, I just wanted to try it out, I'm not hungry.
    - characterName: Yuu
      text: Um... it has no flavor at all.
    - characterName: Navigator
      text: No surprise.
  - questName: Phone
    tasks:
    - taskName: phone
      description: Find and collect my phone
      targetObject: {fileID: 1774402295}
      hideAfterInteract: 1
      isCompleted: 0
    afterDialogue:
    - characterName: Yuu
      text: Finally found the phone
    - characterName: Navigator
      text: It will be very helpful to you from now on, at least you can jot down
        notes of what we discover and keep them in there.
    - characterName: Yuu
      text: Yes, that's right. If I forget anything, I can just open it up and read
        what I've written down.
    - characterName: Navigator
      text: I think we can move on to the next place. Let's try opening the door.
  exitDoor: {fileID: 711898492}
  dialogueManager: {fileID: 765444982}
