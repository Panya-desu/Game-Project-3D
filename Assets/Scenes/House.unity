  m_Script: {fileID: 11500000, guid: 7c529b50416b35a49823adeb0c98b328, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StartDialogueOnScene
  dialogueManager: {fileID: 765444982}
  delay: 3
  lines:
  - characterName: Yuu
    text: 'Huh?

      Why wasn''t I sent back to the white area earlier?'
  - characterName: Navigator
    text: That's right. It seems you're still at home, not sent back to the previous
      white space.
  - characterName: Navigator
    text: Perhaps it's because you can still find more memories of yourself here.
  - characterName: Navigator
    text: It wouldn't hurt to explore a little more.
  - characterName: Yuu
    text: Ok then.
