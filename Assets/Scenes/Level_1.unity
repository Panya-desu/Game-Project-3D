--- !u!114 &935272240
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 935272239}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fe0b5e36f63ac94faf5978e10c70906, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestManager
  questText: {fileID: 244039857}
  quests:
  - questName: A familiar room
    objectives:
    - description: Find Phone
      type: 1
      targetObject: {fileID: 373179864}
      hideOnComplete: 1
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: This is... my phone? It's locked.
    - characterName: You
      text: The lock screen shows a calendar. One day is circled.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Unlock the phone
    objectives:
    - description: Find Password and unlock phone
      type: 4
      targetObject: {fileID: 0}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: 13 May... That day is my birthday?
    - characterName: You
      text: There's a Note app. I should write down anything strange I find.
    - characterName: You
      text: That door has a keypad. The clock on the desk... it stopped at a strange
        time.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Leave the bedroom
    objectives:
    - description: unlock to door
      type: 2
      targetObject: {fileID: 550899240}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: Why does that time feel so heavy?
    - characterName: You
      text: Let's see what's behind the door.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Explore the house
    objectives:
    - description: Open the locked cabinet in the living room
      type: 2
      targetObject: {fileID: 597048621}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: A chart that turns letters into numbers... but the numbers are scrambled.
    - characterName: You
      text: I'd better note this down. A word might become a code.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Find a way out
    objectives:
    - description: Turn on the TV
      type: 0
      targetObject: {fileID: 93252853}
      hideOnComplete: 0
      isCompleted: 0
    - description: Unlock the door to the storage room
      type: 2
      targetObject: {fileID: 1004290187}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: '"Evie"... The TV said it like it was calling me.'
    - characterName: You
      text: The door is open. It feels cold in there.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: The storage room
    objectives:
    - description: Enter the storage room
      type: 3
      targetObject: {fileID: 679825368}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: The lights are so dim... the power is almost gone.
    - characterName: You
      text: That fuse box by the wall is empty. I need to find fuses.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Find the spare fuses
    objectives:
    - description: Find a spare fuse (1/3)
      type: 3
      targetObject: {fileID: 290202144}
      hideOnComplete: 0
      isCompleted: 0
    - description: Find a spare fuse (2/3)
      type: 3
      targetObject: {fileID: 1158431796}
      hideOnComplete: 0
      isCompleted: 0
    - description: Find a spare fuse (3/3)
      type: 3
      targetObject: {fileID: 516519181}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: That's all the fuses.
    - characterName: You
      text: The fuse box has a keyhole. Where is the key?
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Restore the power
    objectives:
    - description: Find the key
      type: 3
      targetObject: {fileID: 1486873467}
      hideOnComplete: 0
      isCompleted: 0
    - description: Open the fuse box
      type: 3
      targetObject: {fileID: 732426704}
      hideOnComplete: 0
      isCompleted: 0
    - description: Insert a fuse (1/3)
      type: 3
      targetObject: {fileID: 1225605598}
      hideOnComplete: 0
      isCompleted: 0
    - description: Insert a fuse (2/3)
      type: 3
      targetObject: {fileID: 631329115}
      hideOnComplete: 0
      isCompleted: 0
    - description: Insert a fuse (3/3)
      type: 3
      targetObject: {fileID: 292657441}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: The power is back!
    - characterName: You
      text: The levers have symbols on them... sun, moon, star. There must be an
        order.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Wake the levers
    objectives:
    - description: Pull the levers in the right order
      type: 3
      targetObject: {fileID: 1433741265}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue:
    - characterName: You
      text: A door... it wasn't there before.
    - characterName: You
      text: It feels like something is trying to stop me. It doesn't matter. I have
        to know who I am.
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - questName: Go deeper
    objectives:
    - description: Go through the new door
      type: 3
      targetObject: {fileID: 1326610767}
      hideOnComplete: 0
      isCompleted: 0
    afterCompleteDialogue: []
    onStart:
      m_PersistentCalls:
        m_Calls: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  dialogueManager: {fileID: 807269242}
